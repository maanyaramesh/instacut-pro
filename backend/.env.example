# Copy this file to .env and fill in your own values. Never commit .env.

# Any random long string — used to sign login tokens.
JWT_SECRET=change-this-to-a-long-random-string

# SQLite is the default and free — no setup needed. To use a free Postgres
# (e.g. from supabase.com or neon.tech) instead, set:
# DATABASE_URL=postgresql://user:password@host:5432/dbname
DATABASE_URL=sqlite:///./instacut.db

# Comma-separated list of frontend origins allowed to call this API.
CORS_ORIGINS=http://localhost:5173,https://your-frontend.vercel.app
